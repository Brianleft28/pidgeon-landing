# Database
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=pidgeon
DB_PASSWORD=pidgeon
DB_DATABASE=pidgeon_db

# App
PORT=3000
NODE_ENV=production

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=3600s

# Mercado Pago
MP_ACCESS_TOKEN=

# Gemini AI
GEMINI_API_KEY=

# TypeORM
# if TYPEORM_SYNC=true the DB schema will be synchronized automatically (not recommended for production)
TYPEORM_SYNC=false
# If true, docker container will attempt to run migrations at startup (using compiled dist files)
TYPEORM_MIGRATIONS_RUN=true
